#include <stdio.h>

int main(int argc, char** argv)
{
	FILE *entrada;
	int c;
	int array[256] = {0};

	if(argc != 2)
	{
		fprintf(stderr,"Erro na chamada do comando.\n");
		fprintf(stderr,"Uso: %s [ARQUIVO].\n", argv[0]);
		return 1;
	}

	entrada = fopen(argv[1],"rb");
	if(!entrada)
	{
		fprintf(stderr,"Arquivo %s não pode ser aberto para leitura\n", argv[1]);
		return 1;
	}

    c = fgetc(entrada);
	while(c != EOF){
	    array[c] += 1;
	    c = fgetc(entrada);
	}
    
    for(int i=0; i<256; i++){
        
        if(array[i] > 0){
            printf("Letra %c apareceu %d vezes.\n", i, array[i]);
        }
    }

	fclose(entrada);
	return 0;
}
